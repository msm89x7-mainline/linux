/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/gpio/gpio.h>
#include "msm8917.dtsi"
#include "pm8937.dtsi"
#include "msm8937-qdsp6.dtsi"

// /delete-node/ &qseecom_mem;

/ {
	model = "Lenovo Tab 4 10 (tbx304x)";
	compatible = "lenovo,tbx304x", "qcom,msm8917";
	chassis-type = "tablet";
 
	qcom,msm-id = <303 0>;
	qcom,board-id = <(((1 & 0xff) << 16) | ((0 & 0xff) << 8) | 11) 0>;
 
	aliases {
		mmc0 = &sdhc_1;
		mmc1 = &sdhc_2;
	};
 
	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
 
		bootargs = "clk_ignore_unused pd_ignore_unused";
		stdout-path = "framebuffer0";
 
		framebuffer0: framebuffer@90001000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x90001000 0x0 (800 * 1280 * 3)>;
			width = <800>;
			height = <1280>;
			stride = <(800 * 3)>;
			format = "r8g8b8";
 
			clocks = <&gcc 116>,
				 <&gcc 117>,
				 <&gcc 125>,
				 <&gcc 122>,
				 <&gcc 118>,
				 <&gcc 123>,
				 <&gcc 120>;
			power-domains = <&gcc 2>;
 
			status = "okay";
		};
	};
 
	reserved-memory {
		framebuffer_mem: framebuffer@90001000 {
			reg = <0x0 0x90001000 0x0 (1280 * 800 * 3)>;
			no-map;
		};
	};
 
	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};
 
	usb_vbus: extcon-usb-dummy {
		compatible = "linux,extcon-usb-dummy";
	};
};
 
&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm8937-regulators";
 
		vdd_s1-supply = <&vph_pwr>;
		vdd_s2-supply = <&vph_pwr>;
		vdd_s3-supply = <&vph_pwr>;
		vdd_s4-supply = <&vph_pwr>;
 
		vdd_l1_l19-supply = <&pm8937_s3>;
		vdd_l2_l23-supply = <&pm8937_s3>;
		vdd_l3-supply = <&pm8937_s3>;
		vdd_l4_l5_l6_l7_l16-supply = <&pm8937_s4>;
		vdd_l8_l11_l12_l17_l22-supply = <&vph_pwr>;
		vdd_l9_l10_l13_l14_l15_l18-supply = <&vph_pwr>;
 
		pm8937_s1: s1 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1225000>;
		};
 
		pm8937_s3: s3 {
			regulator-min-microvolt = <1300000>;
			regulator-max-microvolt = <1300000>;
		};
 
		pm8937_s4: s4 {
			regulator-min-microvolt = <2050000>;
			regulator-max-microvolt = <2050000>;
		};
 
		pm8937_l2: l2 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
 
		pm8937_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
 
		pm8937_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
 
		pm8937_l7: l7 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
 
		pm8937_l8: l8 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2900000>;
		};
 
		pm8937_l9: l9 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3300000>;
		};
 
		pm8937_l10: l10 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
		};
 
		pm8937_l11: l11 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
			regulator-system-load = <200000>;
		};
 
		pm8937_l12: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2950000>;
		};
 
		pm8937_l13: l13 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3075000>;
		};
 
		pm8937_l14: l14 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
		};
 
		pm8937_l15: l15 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
		};
 
		pm8937_l16: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
 
		pm8937_l17: l17 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2850000>;
		};
 
		pm8937_l19: l19 {
			regulator-min-microvolt = <1225000>;
			regulator-max-microvolt = <1350000>;
		};
 
		pm8937_l22: l22 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
		};
 
		pm8937_l23: l23 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
	};
};
 
&sdhc_1 {
	vmmc-supply = <&pm8937_l8>;
	vqmmc-supply = <&pm8937_l5>;
 
	status = "okay";
};
 
&sdhc_2 {
	pinctrl-0 = <&sdc2_default &sdc2_cd_default>;
	pinctrl-1 = <&sdc2_sleep &sdc2_cd_default>;
	pinctrl-names = "default", "sleep";
 
	cd-gpios = <&tlmm 67 0>;
 
	vmmc-supply = <&pm8937_l11>;
	vqmmc-supply = <&pm8937_l12>;
 
	status = "okay";
};
 
&sleep_clk {
	clock-frequency = <32768>;
};
 
&usb {
	dr_mode = "peripheral";
	extcon = <&usb_vbus>;
	status = "okay";
};
 
&usb_hs_phy {
	vdd-supply = <&pm8937_l2>;
	vdda1p8-supply = <&pm8937_l7>;
	vdda3p3-supply = <&pm8937_l13>;
	status = "okay";
};
 
&xo_board {
	clock-frequency = <19200000>;
};
 
&mdss {
	status = "okay";
};
 
&mdss_dsi0 {
	status = "okay";
	vdd-supply = <&pm8937_l17>;
	vcc-supply = <&pm8937_l6>;
 
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
 
		port@1 {
			reg = <1>;
 
			dsi0_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
 
	panel@0 {
		compatible = "mdss,nt35521s-boe";
		reg = <0>;
 
		reset-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;
 
		vcc-supply = <&pm8937_l6>;
		vdd-supply = <&pm8937_l17>;
 
		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};
};
 
&mdss_dsi0_out {
	status = "okay";
};
 

&blsp1_i2c3 {
	status = "okay";
 
	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
 
		interrupt-parent = <&tlmm>;
		interrupts = <65 IRQ_TYPE_EDGE_FALLING>;
 
		reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
		irq-gpios = <&tlmm 65 GPIO_ACTIVE_HIGH>;
 
		vcc-supply = <&pm8937_l6>;
 
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
 
		touchscreen-size-x = <800>;
		touchscreen-size-y = <1280>;
	};
};
 
&tlmm {
	sdc2_cd_default: sdc2-cd-default-state {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
 
	/* Touchscreen pinctrl */
	ts_int_active: ts-int-active-state {
		pins = "gpio65";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
 
	ts_int_suspend: ts-int-suspend-state {
		pins = "gpio65";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
 
	ts_reset_active: ts-reset-active-state {
		pins = "gpio64";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};
 
	ts_reset_suspend: ts-reset-suspend-state {
		pins = "gpio64";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};
};
 
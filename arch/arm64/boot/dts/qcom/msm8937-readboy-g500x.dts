/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

#include "msm8937.dtsi"
#include "pm8937.dtsi"
#include "pmi8950.dtsi"
#include "msm8937-qdsp6.dtsi"

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. MSM8937-PMI8937 QRD SKU2";
	compatible = "qcom,msm8937-pmi8937-qrd-sku2", "qcom,msm8937-qrd", "qcom,msm8937", "qcom,qrd";
	qcom,msm-id = <0x126 0x00 0x127 0x00>;
	interrupt-parent = <0x01>;
	qcom,board-id = <0x2000b 0x00>;

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;
			enable-method = "psci";
			qcom,acc = <0x0a>;
			qcom,limits-info = <0x0b>;
			next-level-cache = <0x0c>;
			linux,phandle = <0x06>;
			phandle = <0x06>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				power-domain = <0x0d>;
				qcom,dump-size = <0x00>;
				linux,phandle = <0x0c>;
				phandle = <0x0c>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x1f>;
				phandle = <0x1f>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x27>;
				phandle = <0x27>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;
			enable-method = "psci";
			qcom,acc = <0x0e>;
			qcom,limits-info = <0x0f>;
			next-level-cache = <0x0c>;
			linux,phandle = <0x07>;
			phandle = <0x07>;

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x20>;
				phandle = <0x20>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x28>;
				phandle = <0x28>;
			};
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;
			enable-method = "psci";
			qcom,acc = <0x10>;
			qcom,limits-info = <0x11>;
			next-level-cache = <0x0c>;
			linux,phandle = <0x08>;
			phandle = <0x08>;

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x21>;
				phandle = <0x21>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x29>;
				phandle = <0x29>;
			};
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;
			enable-method = "psci";
			qcom,acc = <0x12>;
			qcom,limits-info = <0x13>;
			next-level-cache = <0x0c>;
			linux,phandle = <0x09>;
			phandle = <0x09>;

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x22>;
				phandle = <0x22>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x2a>;
				phandle = <0x2a>;
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			qcom,acc = <0x14>;
			qcom,limits-info = <0x15>;
			next-level-cache = <0x16>;
			linux,phandle = <0x02>;
			phandle = <0x02>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				power-domain = <0x17>;
				qcom,dump-size = <0x00>;
				linux,phandle = <0x16>;
				phandle = <0x16>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x1b>;
				phandle = <0x1b>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x23>;
				phandle = <0x23>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			qcom,acc = <0x18>;
			qcom,limits-info = <0x15>;
			next-level-cache = <0x16>;
			linux,phandle = <0x03>;
			phandle = <0x03>;

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x1c>;
				phandle = <0x1c>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x24>;
				phandle = <0x24>;
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			qcom,acc = <0x19>;
			qcom,limits-info = <0x15>;
			next-level-cache = <0x16>;
			linux,phandle = <0x04>;
			phandle = <0x04>;

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x1d>;
				phandle = <0x1d>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x25>;
				phandle = <0x25>;
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			qcom,acc = <0x1a>;
			qcom,limits-info = <0x15>;
			next-level-cache = <0x16>;
			linux,phandle = <0x05>;
			phandle = <0x05>;

			l1-icache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x8800>;
				linux,phandle = <0x1e>;
				phandle = <0x1e>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x9000>;
				linux,phandle = <0x26>;
				phandle = <0x26>;
			};
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";

		pinctrl@1000000 {
			compatible = "qcom,msm8937-pinctrl";
			reg = <0x1000000 0x300000>;
			interrupts = <0x00 0xd0 0x00>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			linux,phandle = <0xa7>;
			phandle = <0xa7>;

			pmx-uartconsole {

				uart_console_active {
					linux,phandle = <0xbf>;
					phandle = <0xbf>;

					mux {
						pins = "gpio4", "gpio5";
						function = "blsp_uart2";
					};

					config {
						pins = "gpio4", "gpio5";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				uart_console_sleep {

					mux {
						pins = "gpio4", "gpio5";
						function = "blsp_uart2";
					};

					config {
						pins = "gpio4", "gpio5";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			i2c_2 {

				i2c_2_active {
					linux,phandle = <0xc0>;
					phandle = <0xc0>;

					mux {
						pins = "gpio6", "gpio7";
						function = "blsp_i2c2";
					};

					config {
						pins = "gpio6", "gpio7";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				i2c_2_sleep {
					linux,phandle = <0xc1>;
					phandle = <0xc1>;

					mux {
						pins = "gpio6", "gpio7";
						function = "gpio";
					};

					config {
						pins = "gpio6", "gpio7";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			i2c_3 {

				i2c_3_active {
					linux,phandle = <0xcd>;
					phandle = <0xcd>;

					mux {
						pins = "gpio10", "gpio11";
						function = "blsp_i2c3";
					};

					config {
						pins = "gpio10", "gpio11";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				i2c_3_sleep {
					linux,phandle = <0xce>;
					phandle = <0xce>;

					mux {
						pins = "gpio10", "gpio11";
						function = "gpio";
					};

					config {
						pins = "gpio10", "gpio11";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			i2c_5 {

				i2c_5_active {
					linux,phandle = <0xda>;
					phandle = <0xda>;

					mux {
						pins = "gpio18", "gpio19";
						function = "blsp_i2c5";
					};

					config {
						pins = "gpio18", "gpio19";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				i2c_5_sleep {
					linux,phandle = <0xdb>;
					phandle = <0xdb>;

					mux {
						pins = "gpio18", "gpio19";
						function = "gpio";
					};

					config {
						pins = "gpio18", "gpio19";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			pmx_rd_nfc_int {
				pins = "gpio17";
				qcom,pin-func = <0x00>;
				qcom,num-grp-pins = <0x01>;
				label = "pmx_nfc_int";

				active {
					drive-strength = <0x06>;
					bias-pull-up;
					linux,phandle = <0xde>;
					phandle = <0xde>;
				};

				suspend {
					drive-strength = <0x06>;
					bias-pull-up;
					linux,phandle = <0xe0>;
					phandle = <0xe0>;
				};
			};

			pmx_nfc_reset {
				pins = "gpio16";
				qcom,pin-func = <0x00>;
				qcom,num-grp-pins = <0x01>;
				label = "pmx_nfc_disable";

				active {
					drive-strength = <0x06>;
					bias-pull-up;
					linux,phandle = <0xdf>;
					phandle = <0xdf>;
				};

				suspend {
					drive-strength = <0x06>;
					bias-disable;
					linux,phandle = <0xe1>;
					phandle = <0xe1>;
				};
			};

			tlmm_pmi_flash_led {

				rear_flash_led_enable {

					mux {
						pins = "gpio33";
						function = "gpio";
					};

					config {
						pins = "gpio33";
						drive-strength = <0x10>;
						output-high;
					};
				};

				rear_flash_led_disable {

					mux {
						pins = "gpio33";
						function = "gpio";
					};

					config {
						pins = "gpio33";
						drive-strength = <0x02>;
						output-low;
					};
				};

				front_flash_led_enable {

					mux {
						pins = "gpio50";
						function = "gpio";
					};

					config {
						pins = "gpio50";
						drive-strength = <0x10>;
						output-high;
					};
				};

				front_flash_led_disable {

					mux {
						pins = "gpio50";
						function = "gpio";
					};

					config {
						pins = "gpio50";
						drive-strength = <0x02>;
						output-low;
					};
				};
			};

			spi3 {

				spi3_default {
					linux,phandle = <0xe2>;
					phandle = <0xe2>;

					mux {
						pins = "gpio8", "gpio9", "gpio11";
						function = "blsp_spi3";
					};

					config {
						pins = "gpio8", "gpio9", "gpio11";
						drive-strength = <0x0c>;
						bias-disable = <0x00>;
					};
				};

				spi3_sleep {
					linux,phandle = <0xe4>;
					phandle = <0xe4>;

					mux {
						pins = "gpio8", "gpio9", "gpio11";
						function = "gpio";
					};

					config {
						pins = "gpio8", "gpio9", "gpio11";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				cs0_active {
					linux,phandle = <0xe3>;
					phandle = <0xe3>;

					mux {
						pins = "gpio10";
						function = "blsp_spi3";
					};

					config {
						pins = "gpio10";
						drive-strength = <0x02>;
						bias-disable = <0x00>;
					};
				};

				cs0_sleep {
					linux,phandle = <0xe5>;
					phandle = <0xe5>;

					mux {
						pins = "gpio10";
						function = "gpio";
					};

					config {
						pins = "gpio10";
						drive-strength = <0x02>;
						bias-disable = <0x00>;
					};
				};
			};

			wcnss_pmux_5wire {

				wcnss_default {
					linux,phandle = <0xf6>;
					phandle = <0xf6>;

					wcss_wlan2 {
						pins = "gpio76";
						function = "wcss_wlan2";
					};

					wcss_wlan1 {
						pins = "gpio77";
						function = "wcss_wlan1";
					};

					wcss_wlan0 {
						pins = "gpio78";
						function = "wcss_wlan0";
					};

					wcss_wlan {
						pins = "gpio79", "gpio80";
						function = "wcss_wlan";
					};

					config {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						drive-strength = <0x06>;
						bias-pull-up;
					};
				};

				wcnss_sleep {
					linux,phandle = <0xf7>;
					phandle = <0xf7>;

					wcss_wlan2 {
						pins = "gpio76";
						function = "wcss_wlan2";
					};

					wcss_wlan1 {
						pins = "gpio77";
						function = "wcss_wlan1";
					};

					wcss_wlan0 {
						pins = "gpio78";
						function = "wcss_wlan0";
					};

					wcss_wlan {
						pins = "gpio79", "gpio80";
						function = "wcss_wlan";
					};

					config {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			wcnss_pmux_gpio {

				wcnss_gpio_default {
					linux,phandle = <0xf8>;
					phandle = <0xf8>;

					mux {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						function = "gpio";
					};

					config {
						pins = "gpio76", "gpio77", "gpio78", "gpio79", "gpio80";
						drive-strength = <0x06>;
						bias-pull-up;
					};
				};
			};

			blsp2_uart1_active {
				linux,phandle = <0xf1>;
				phandle = <0xf1>;

				mux {
					pins = "gpio16", "gpio17", "gpio18", "gpio19";
					function = "blsp_uart5";
				};

				config {
					pins = "gpio16", "gpio17", "gpio18", "gpio19";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			blsp2_uart1_sleep {
				linux,phandle = <0xf0>;
				phandle = <0xf0>;

				mux {
					pins = "gpio16", "gpio17", "gpio18", "gpio19";
					function = "gpio";
				};

				config {
					pins = "gpio16", "gpio17", "gpio18", "gpio19";
					drive-strength = <0x02>;
					bias-disable;
				};
			};

			pmx_adv7533_int {

				adv7533_int_active {
					linux,phandle = <0xc4>;
					phandle = <0xc4>;

					mux {
						pins = "gpio126";
						function = "gpio";
					};

					config {
						pins = "gpio126";
						drive-strength = <0x10>;
						bias-disable;
					};
				};

				adv7533_int_suspend {
					linux,phandle = <0xc5>;
					phandle = <0xc5>;

					mux {
						pins = "gpio126";
						function = "gpio";
					};

					config {
						pins = "gpio126";
						drive-strength = <0x10>;
						bias-disable;
					};
				};
			};

			pmx_mdss {

				mdss_dsi_active {

					mux {
						pins = "gpio60", "gpio98", "gpio99";
						function = "gpio";
					};

					config {
						pins = "gpio60", "gpio98", "gpio99";
						drive-strength = <0x08>;
						bias-disable = <0x00>;
						output-high;
					};
				};

				mdss_dsi_suspend {

					mux {
						pins = "gpio60", "gpio98", "gpio99";
						function = "gpio";
					};

					config {
						pins = "gpio60", "gpio98", "gpio99";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};
			};

			pmx_mdss_te {

				mdss_te_active {

					mux {
						pins = "gpio24";
						function = "mdp_vsync";
					};

					config {
						pins = "gpio24";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				mdss_te_suspend {

					mux {
						pins = "gpio24";
						function = "mdp_vsync";
					};

					config {
						pins = "gpio24";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			usbc_int_default {
				linux,phandle = <0xc3>;
				phandle = <0xc3>;

				mux {
					pins = "gpio97", "gpio131";
					function = "gpio";
				};

				config {
					pins = "gpio97", "gpio131";
					drive-strength = <0x02>;
					bias-pull-up;
				};
			};

			tlmm_gpio_key {

				gpio_key_active {
					linux,phandle = <0x189>;
					phandle = <0x189>;

					mux {
						pins = "gpio91", "gpio124";
						function = "gpio";
					};

					config {
						pins = "gpio91", "gpio124";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};

				gpio_key_suspend {
					linux,phandle = <0x18a>;
					phandle = <0x18a>;

					mux {
						pins = "gpio91", "gpio124";
						function = "gpio";
					};

					config {
						pins = "gpio91", "gpio124";
						drive-strength = <0x02>;
						bias-pull-up;
					};
				};
			};

			ts_int_defalut {
				linux,phandle = <0xd3>;
				phandle = <0xd3>;

				mux {
					pins = "gpio65";
					function = "gpio";
				};

				config {
					pins = "gpio65";
					drive-strength = <0x10>;
					input-enable;
					bias-disable;
				};
			};

			ts_int_output_high {
				linux,phandle = <0xd5>;
				phandle = <0xd5>;

				mux {
					pins = "gpio65";
					function = "gpio";
				};

				config {
					pins = "gpio65";
					output-high;
				};
			};

			ts_int_output_low {
				linux,phandle = <0xd4>;
				phandle = <0xd4>;

				mux {
					pins = "gpio65";
					function = "gpio";
				};

				config {
					pins = "gpio65";
					output-low;
				};
			};

			ts_int_input {
				linux,phandle = <0xd6>;
				phandle = <0xd6>;

				mux {
					pins = "gpio65";
					function = "gpio";
				};

				config {
					pins = "gpio65";
					input-enable;
					bias-disable;
